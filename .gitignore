# ==========================================
# MASTER GITIGNORE CONFIGURATION (Monorepo)
# ==========================================

# 1. Dependencies & Heavy Libraries (NEVER commit to Git)
node_modules/
backend/node_modules/
frontend/node_modules/

# 2. Environment Variables & Secret Key Files (NEVER commit to Git)
.env
backend/.env
frontend/.env
*.env.local

# 3. Production Build & Output Directories
dist/
dist-ssr/
build/
reports/*.pdf
backend/reports/

# 4. OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# 5. Logs & Debug Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*